{
  "manifest_version": 2,
  "name": "YACE: Yet Another Canvas Extension",
  "version": "3.0",
  "description": "YACE \u2014 Yet Another Canvas Extension. Unifies Canvas assignments, PDFs, Gradescope tasks, and announcements into a cyber-deck HUD.",
  "permissions": [
    "https://mycourses.unh.edu/*",
    "https://www.gradescope.com/*",
    "https://www.ratemyprofessors.com/*",
    "https://unh.instructure.com/*",
    "*://*.instructuremedia.com/*",
    "*://*.instructure.com/*",
    "*://*.inscloudgate.net/*",
    "*://foodpro.unh.edu/*",
    "https://www.unh.edu/*",
    "https://unh.edu/*",
    "https://courses.unh.edu/*",
    "https://webcat.unh.edu/*",
    "https://25livepub.collegenet.com/*",
    "storage",
    "cookies",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mycourses.unh.edu/",
        "https://mycourses.unh.edu/?*",
        "https://mycourses.unh.edu/courses",
        "https://unh.instructure.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "css": [
        "css/tokens.css",
        "css/canvas-overrides.css",
        "css/widget-shell.css",
        "css/widget-header.css",
        "css/overlays.css",
        "css/task-cards.css",
        "css/hud.css",
        "css/view-general.css",
        "css/view-announcements.css",
        "css/modals.css",
        "css/view-campus.css",
        "css/custom-assignments.css",
        "css/view-grades.css",
        "css/view-dining.css",
        "css/view-schedule.css",
        "css/view-kanban.css",
        "css/view-days-off.css",
        "css/fullscreen.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://webcat.unh.edu/StudentRegistrationSsb/*"
      ],
      "js": [
        "dist/registration.js"
      ],
      "css": [
        "css/registration.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-unified-tasks@yourgithubusername.github.io"
    }
  }
}